{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":dependencyDashboard"],
  "timezone": "Europe/London",
  "schedule": ["* 0-6 * * 1"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "7 days",
  "rebaseWhen": "conflicted",
  "constraints": { "python": "==3.14" },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "schedule": [],
    "minimumReleaseAge": null
  },
  "major": { "dependencyDashboardApproval": true },
  "packageRules": [
    {
      "description": "One PR for every non-major npm update",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "npm non-major"
    },
    {
      "description": "One PR for every non-major Python update",
      "matchManagers": ["pip_requirements"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python non-major"
    },
    {
      "description": "CI actions move together and automerge once green",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Majors are opened one at a time and routed to Devin",
      "matchUpdateTypes": ["major"],
      "labels": ["needs-devin-validation"]
    }
  ]
}
